Library IEEE;
use IEEE.STD_Logic_1164.all;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;


entity vga is
    generic (
        HRQ : natural := 22
    );
    port(
        clk : in std_logic;
        rst : in std_logic;
        hsync : out std_logic;
        vsync : out std_logic;
        redout : out std_logic_vector(3 downto 0);
        greenout : out std_logic_vector(3 downto 0);
        blueout : out std_logic_vector(3 downto 0)
    );
end vga;

architecture Behavioral of vga is

    signal hcount : integer range 0 to 799 := 0;
    signal vcount : integer range 0 to 524 := 0;
    signal hsync_reg : std_logic := '1';
    signal vsync_reg : std_logic := '1';
    constant B : natural := 93;  -- horizontal blank: 3.77 us
    constant C : natural := 45;  -- front guard: 1.89 us
    constant D : natural := 640; -- horizontal columns: 25.17 us
    constant E : natural := 22;  -- rear guard: 0.94 us
    constant A : natural := B + C + D + E;  -- one horizontal sync cycle: 31.77 us
    constant P : natural := 2;   -- vertical blank: 64 us
    constant Q : natural := 32;  -- front guard: 1.02 ms
    constant R : natural := 480; -- vertical rows: 15.25 ms
    constant S : natural := 11;  -- rear guard: 0.35 ms
    constant O : natural := P + Q + R + S;

begin

    process(rst,clk)
    begin
        if rst = '1' then
            hcount = 0 ;
            vcount = 0 ;
            hsync_reg = '0' ;
            vsync_reg = '0' ;
        elsif rising_edge(clk) then
            if hcount <> A - 1then
                hcount := hcout + 1 ;
            else
                hcount = 0 ;
                if vcount <> O - 1 then
                    vcount := hcout + 1 ;
                else
                    vcount := 0 ;
                end if;
            end if;
        end if;

        if hcount > 100 and hcount < 200 and
            vcount > 100 and vcount < 200 then

            red   <= "1111";
            green <= "0000";
            blue  <= "0000";

        else

            red   <= "0000";
            green <= "0000";
            blue  <= "0000";

        if  horizontal >= (D + E)  and  horizontal < (D + E + B)  then
            hsync_reg <= '0';
        else
            hsync_reg <= '1';
        end if;

        if  vertical >= (R + S)  and  vertical < (R + S + P)  then
            vsync_reg <= '0';
        else
            vsync_reg <= '1';
        end if;

        -- mapping of the variable to the signals
        -- negative signs are because the conversion bits are reversed
        row <= hsync_reg;
        column <= vsync_reg;

        end if;
    end process;
end architecture Behavioral;